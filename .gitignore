# ==========================================
#  db-live-diff Production .gitignore
# ==========================================

# --- Project-Specific Temp Folders ---
# Excludes the runtime database introspection caches and workspaces
.temp_diff/
*.prisma.backup
backend/.temp_diff/
backend/prisma/

# --- Local Databases (Crucial) ---
# Excludes local test databases and SQLite engine lock/journal files
*.db
*.db-journal
*.sqlite
*.sqlite-journal
*.sqlite3
dev.db
dev.db-journal

# --- Dependency Directories ---
node_modules/
jspm_packages/
web_stage/

# --- Build & Bundle Outputs ---
dist/
build/
out/
.next/
.nuxt/
.cache/
.parcel-cache/
.turbo/

# --- Environment Configuration ---
# Keep your credentials and local paths out of Git
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# --- Debug & Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*
logs/
*.syslog

# --- TypeScript ---
# Exclude compilation caches
*.tsbuildinfo

# --- Editor / IDE Metadata ---
# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

# IntelliJ / WebStorm / PhpStorm
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Operating System Files ---
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# --- Test Coverage & Tooling ---
coverage/
.nyc_output/
.cypress/
